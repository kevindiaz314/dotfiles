#!/usr/bin/env fish

{{ template "scripts/lib.fish" . }}

# Rendering agent data here makes list changes invalidate Chezmoi's script hash.
tn_section 'Tools · Coding agents'

# Global npm packages live under the npm prefix; keep it inside $HOME so
# installs and self-updates never need sudo. ~/.local/bin is already in PATH.
if command --query npm
    set --local npm_prefix (npm config get prefix)
    or begin
        tn_error 'Failed to read the npm prefix.'
        exit 1
    end
    if not string match --quiet "$HOME/*" $npm_prefix
        tn_info "Moving the npm prefix to ~/.local (was $npm_prefix)."
        npm config set prefix $HOME/.local
        or begin
            tn_error 'Failed to set the npm prefix.'
            exit 1
        end
    end
end

function install_agent --argument-names name method package url trust
    if command --query $name
        tn_success "$name is already installed."
        return 0
    end

    switch $method
        case npm
            if not command --query npm
                tn_error "Cannot install $name: npm is not installed."
                return 1
            end
            tn_info "Installing $name via npm ($package)."
            npm install --global $package
        case bun
            if not command --query bun
                tn_error "Cannot install $name: bun is not installed."
                return 1
            end
            tn_info "Installing $name via bun ($package)."
            if test "$trust" = true
                bun install --global --trust $package
            else
                bun install --global $package
            end
        case curl
            if not command --query curl; or not command --query bash
                tn_error "Cannot install $name: curl and bash are required."
                return 1
            end
            tn_info "Installing $name via its vendor installer ($url)."
            # Download before executing so download failures are reported.
            set --local installer (mktemp)
            or begin
                tn_error "Failed to create a temporary file for $name."
                return 1
            end
            curl -fsSL $url -o $installer
            and bash $installer
            set --local installer_status $status
            rm -f $installer
            test $installer_status -eq 0
        case '*'
            tn_error "Unknown install method '$method' for $name."
            return 1
    end
    set --local install_status $status

    if test $install_status -ne 0
        tn_error "Failed to install $name."
        return 1
    end
    if not command --query $name
        tn_error "$name installed but is not available on PATH."
        return 1
    end
    tn_success "$name installed."
end

# Regenerate declared completions whenever this script changes.
function generate_completions --argument-names name
    set --local command_line $argv[2..]
    if not command --query $name
        return 0
    end

    set --local completions_dir $HOME/.config/fish/completions
    mkdir -p $completions_dir
    tn_info "Generating fish completions for $name."
    # Stage in a temporary file so a failing generator cannot truncate a
    # previously valid completions file.
    set --local staging (mktemp)
    or begin
        tn_error "Failed to create a temporary completions file for $name."
        return 1
    end
    command $command_line >$staging
    and mv $staging $completions_dir/$name.fish
    or begin
        rm -f $staging
        tn_error "Failed to generate completions for $name."
        return 1
    end
end

set --global failures 0
{{ range .packages.coding_agents -}}
install_agent {{ .name | quote }} {{ .method | quote }} {{ get . "package" | default "" | quote }} {{ get . "url" | default "" | quote }} {{ get . "trust" | default false | quote }}
or set failures (math $failures + 1)
{{ end -}}
{{ range .packages.coding_agents -}}
{{ if hasKey . "completions" -}}
generate_completions {{ .name | quote }}{{ range .completions }} {{ . | quote }}{{ end }}
or set failures (math $failures + 1)
{{ end -}}
{{ end }}
if test $failures -gt 0
    tn_error "$failures coding-agent step(s) failed."
    exit 1
end

tn_success 'Coding-agent reconciliation finished.'
