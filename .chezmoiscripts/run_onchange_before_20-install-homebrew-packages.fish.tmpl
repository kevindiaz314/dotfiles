{{ if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env fish

{{ template "scripts/lib.fish" . }}

# `run_onchange_` means Chezmoi reruns this script when its rendered contents
# change. Editing packages.yaml changes the rendered arrays below.
tn_section 'Packages · Homebrew'

# Do not depend on Fish startup configuration: Homebrew may not yet be in PATH.
set --local brew (tn_find_brew)
if test $status -ne 0
    tn_error 'Homebrew was not found after the bootstrap step.'
    exit 1
end

# Chezmoi renders the YAML lists into Fish arrays before execution.
set --local taps{{ range .packages.darwin.taps }} {{ . | quote }}{{ end }}
set --local formulae{{ range .packages.darwin.brews }} {{ . | quote }}{{ end }}
set --local casks{{ range .packages.darwin.casks }} {{ . | quote }}{{ end }}
set --local installed_taps ($brew tap)
set --local missing_formulae
set --local missing_casks

# Homebrew uses separate commands and inventories for taps, formulae, and
# casks, so reconcile each category independently.
for tap in $taps
    if not contains -- $tap $installed_taps
        tn_info "Adding Homebrew tap $tap."
        tn_command $brew tap $tap
        $brew tap $tap
        or begin
            tn_error "Failed to add Homebrew tap $tap."
            exit 1
        end
    end
end

for formula in $formulae
    if not $brew list --formula $formula >/dev/null 2>&1
        set --append missing_formulae $formula
    end
end

if test (count $missing_formulae) -gt 0
    tn_info 'Installing missing Homebrew formulae:'
    tn_detail (string join ', ' -- $missing_formulae)
    tn_command $brew install $missing_formulae
    $brew install $missing_formulae
    or begin
        tn_error 'Homebrew formula installation failed.'
        exit 1
    end
else
    tn_success 'All declared Homebrew formulae are installed.'
end

for cask in $casks
    if not $brew list --cask $cask >/dev/null 2>&1
        set --append missing_casks $cask
    end
end

if test (count $missing_casks) -gt 0
    tn_info 'Installing missing Homebrew casks:'
    tn_detail (string join ', ' -- $missing_casks)
    tn_command $brew install --cask $missing_casks
    $brew install --cask $missing_casks
    or begin
        tn_error 'Homebrew cask installation failed.'
        exit 1
    end
else
    tn_success 'All declared Homebrew casks are installed.'
end

tn_success 'Homebrew package reconciliation finished.'
{{ end -}}
