{{ if eq .chezmoi.os "linux" -}}
#!/usr/bin/env fish

{{ template "scripts/lib.fish" . }}

# Rendering package data here makes list changes invalidate Chezmoi's script hash.
tn_section 'Packages · CachyOS'

if not command --query pacman
    tn_error 'pacman was not found; this Linux package setup supports CachyOS/Arch systems only.'
    exit 1
end

set --local pacman_packages{{ range .packages.linux.pacman }} {{ . | quote }}{{ end }}
set --local aur_packages{{ range .packages.linux.aur }} {{ . | quote }}{{ end }}
set --local missing_pacman
set --local missing_aur

# Avoid invoking Pacman when everything is already installed.
for package in $pacman_packages
    if not pacman --query $package >/dev/null 2>&1
        set --append missing_pacman $package
    end
end

if test (count $missing_pacman) -gt 0
    tn_info 'Installing missing official repository packages:'
    tn_detail (string join ', ' -- $missing_pacman)
    tn_warn 'Pacman will perform a full upgrade and remain interactive.'

    sudo pacman -Syu --needed $missing_pacman
    or begin
        tn_error 'Pacman package installation failed.'
        exit 1
    end
else
    tn_success 'All declared Pacman packages are installed.'
end

# AUR packages also appear in Pacman's local database.
for package in $aur_packages
    if not pacman --query $package >/dev/null 2>&1
        set --append missing_aur $package
    end
end

if test (count $missing_aur) -gt 0
    # Prefer CachyOS's default while respecting an existing Yay setup.
    set --local aur_helper
    if command --query paru
        set aur_helper paru
    else if command --query yay
        set aur_helper yay
    else
        tn_error 'AUR packages are missing, but neither paru nor yay is installed.'
        exit 1
    end

    tn_info "Using $aur_helper to install missing AUR packages:"
    tn_detail (string join ', ' -- $missing_aur)
    tn_warn "$aur_helper remains interactive so you can inspect PKGBUILDs and package decisions."

    $aur_helper -S --needed $missing_aur
    or begin
        tn_error 'AUR package installation failed.'
        exit 1
    end
else
    tn_success 'All declared AUR packages are installed.'
end

tn_success 'CachyOS package reconciliation finished.'
{{ end -}}
