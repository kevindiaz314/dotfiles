{{- /* Commit signing needs the owner's private key, so it is only
       configured when the identity entered at init time is theirs. */ -}}
{{- $personal := eq .email "developer@kev314.dev" -}}
{{- if $personal -}}
[gpg]
  format = ssh
{{ end -}}
[user]
{{- if $personal }}
  signingkey = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIA9SvPe8Psw9urHZfHqMQZ5uAoLc74pVqhxUHafpar9K"
{{- end }}
  name = {{ .name }}
  email = {{ .email }}
{{- if $personal }}
[commit]
  gpgsign = true
{{- end }}
