// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// https://niri-wm.github.io/niri/Configuration:-Introduction

include "autostart.kdl"
include "input.kdl"
include "monitors.kdl"
include "window-rules.kdl"
include "keybinds.kdl"

// https://niri-wm.github.io/niri/Configuration:-Layout
layout {
  // Gaps around windows in logical pixels.
  gaps 10

  // Center a focused column when it doesn't fit together with the
  // previously focused one.
  center-focused-column "on-overflow"
  always-center-single-column

  // Widths that switch-preset-column-width (Mod+R) toggles between,
  // as fractions of the output width.
  preset-column-widths {
    proportion 0.33333
    proportion 0.5
    proportion 0.66667
  }

  // Default width of new windows.
  default-column-width { proportion 0.5; }

  focus-ring {
    // How many logical pixels the ring extends out from the windows.
    width 3
    active-gradient from="#80c8ff" to="#c7ff7f" angle=45
    // The focus ring only draws around the active window, so
    // inactive-gradient is only visible on other monitors.
    inactive-gradient from="#505050" to="#808080" angle=45 relative-to="workspace-view"
  }

  // Always-visible border; disabled in favor of the focus ring.
  border {
    off

    width 3
    active-color "#ffc87f"
    inactive-color "#505050"
    urgent-color "#9b0000"
  }

  // Uncomment `on` to enable drop shadows.
  // Values are in logical pixels and match the CSS box-shadow properties.
  shadow {
    // on

    softness 30
    spread 5
    offset x=0 y=5
    color "#0007"
  }
}

hotkey-overlay {
  // Disable the "Important Hotkeys" pop-up at startup.
  skip-at-startup
}

// Ask clients to omit their client-side decorations. Also informs clients
// that they are tiled, removing some client-side rounded corners.
prefer-no-csd

// The path is formatted with strftime(3).
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
