// ▗▄▄▄▖▗▖  ▗▖▗▄▄▖ ▗▖ ▗▖▗▄▄▄▖
//   █  ▐▛▚▖▐▌▐▌ ▐▌▐▌ ▐▌  █
//   █  ▐▌ ▝▜▌▐▛▀▘ ▐▌ ▐▌  █
// ▗▄█▄▖▐▌  ▐▌▐▌   ▝▚▄▞▘  █

input {
  keyboard {
    repeat-delay 200
    repeat-rate 55
  }

  touchpad {
    tap
    natural-scroll
    accel-speed 0.6
  }

  mouse {
    accel-speed 0.6
  }

  focus-follows-mouse
}
