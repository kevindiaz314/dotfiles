// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "diff_view_style": "split",
  "vim": {
    "use_system_clipboard": "never"
  },
  "proxy": "",
  "helix_mode": false,
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "agent": {
    "play_sound_when_agent_done": "always",
    "single_file_review": true,
    "dock": "left",
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.6-sol",
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [
      {
        "provider": "zed.dev",
        "model": "gpt-5.6-sol",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": []
  },
  "terminal": {
    
  },
  "vim_mode": true,
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "base_keymap": "VSCode",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "VSCode Icons for Zed (Dark Official Icons)"
  },
  "ui_font_size": 16,
  "theme": {
    "mode": "dark",
    "light": "Tokyo Night Light",
    "dark": "Catppuccin Mocha",
  },
}
