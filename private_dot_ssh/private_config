# Private hosts live in ~/.ssh/config.local, which is not tracked by chezmoi
# and must be copied to new machines manually.
Include config.local

Host github.com
    AddKeysToAgent yes
    User git
    IdentityFile ~/.ssh/github_key
    IdentitiesOnly yes

Host aur.archlinux.org
    User kevindiaz314
    IdentityFile ~/.ssh/aur_key
    IdentitiesOnly yes
